generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id            String     @id @default(uuid())
  walletAddress String     @unique
  campaigns     Campaign[]
  affiliate     Affiliate?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Campaign {
  id                String   @id @default(uuid())
  name              String
  rewardAmount      Float
  challengeCriteria String
  status            String   @default("DEPLOYED")
  category          String?
  participantsCount Int      @default(0)
  endDate           DateTime?
  imageUrl          String?
  shortDescription  String?
  description       String?
  walletPolicies    String?
  privyPolicyId     String?
  agentRegistry     String?
  agentId           String?
  agentRefreshToken String?
  managerId         String
  manager           Profile  @relation(fields: [managerId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Affiliate {
  id                      String   @id @default(uuid())
  profileId               String   @unique
  profile                 Profile  @relation(fields: [profileId], references: [id])
  description             String?
  agentURI                String?
  referralCode            String   @unique
  
  // Tracking Scores
  totalClicks             Int      @default(0)
  genuineClicks           Int      @default(0)
  successfulConversions   Int      @default(0)
  earnedRewards           Float    @default(0.0)
  
  trafficReliabilityScore Float    @default(0.0)
  trafficPerformanceScore Float    @default(0.0)
  rewardPerformanceScore  Float    @default(0.0)
  recencyScore            Float    @default(0.0)
  audienceAlignmentScore  Float    @default(0.0)
  overallReputationScore  Float    @default(0.0)
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
